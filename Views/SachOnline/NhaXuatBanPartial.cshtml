@model IEnumerable<TanHoangAnh.SachOnline.Models.NHAXUATBAN>
<aside class="so-sidebar-widget">
    <div class="widget-header"><i class="bi bi-building"></i> Nhà xuất bản</div>
    <ul class="list-group list-group-flush">
        @foreach (var nxb in Model)
        {
            <li class="list-group-item">
                <a href="@Url.Action("SachTheoNhaXuatBan", "SachOnline", new { id = nxb.MaNXB })">
                    @nxb.TenNXB <i class="bi bi-chevron-right"></i>
                </a>
            </li>
        }
    </ul>
</aside>
