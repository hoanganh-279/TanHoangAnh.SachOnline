<div class="so-topbar d-none d-lg-block">
    <div class="container d-flex justify-content-between align-items-center">
        <span><i class="bi bi-envelope me-1"></i> trungtamtuvan@sachonline.vn</span>
        <span><i class="bi bi-telephone me-1"></i> Hotline: <a href="tel:19001234">1900 1234</a> — Miễn phí vận chuyển đơn từ 300.000đ</span>
    </div>
</div>
<nav class="navbar navbar-expand-lg navbar-dark so-navbar sticky-top">
    <div class="container">
        <a class="navbar-brand" href="@Url.Action("Index", "SachOnline")">Sach<span>Online</span></a>
        <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#mainMenu" aria-controls="mainMenu" aria-expanded="false" aria-label="Menu">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="mainMenu">
            <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                @{
                    var activeMenu = ViewBag.ActiveMenu as string ?? "";
                }
                <li class="nav-item">
                    <a class="nav-link @(activeMenu == "Index" ? "active" : "")" href="@Url.Action("Index", "SachOnline")">
                        <i class="bi bi-house-door me-1"></i> Trang chủ
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(activeMenu == "GioiThieu" ? "active" : "")" href="@Url.Action("GioiThieu", "SachOnline")">Giới thiệu</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(activeMenu == "LienHe" ? "active" : "")" href="@Url.Action("LienHe", "SachOnline")">Liên hệ</a>
                </li>
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">Chủ đề</a>
                    <ul class="dropdown-menu">
                        <li><a class="dropdown-item" href="@Url.Action("SachTheoChuDe", "SachOnline", new { id = 1 })">Ngoại ngữ</a></li>
                        <li><a class="dropdown-item" href="@Url.Action("SachTheoChuDe", "SachOnline", new { id = 2 })">Công nghệ thông tin</a></li>
                        <li><a class="dropdown-item" href="@Url.Action("SachTheoChuDe", "SachOnline", new { id = 3 })">Văn học</a></li>
                    </ul>
                </li>
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">Nhà xuất bản</a>
                    <ul class="dropdown-menu">
                        <li><a class="dropdown-item" href="@Url.Action("SachTheoNhaXuatBan", "SachOnline", new { id = 1 })">Nhà xuất bản Trẻ</a></li>
                        <li><a class="dropdown-item" href="@Url.Action("SachTheoNhaXuatBan", "SachOnline", new { id = 2 })">NXB Tổng hợp</a></li>
                    </ul>
                </li>
            </ul>
            <form class="d-flex so-search me-lg-3 mb-2 mb-lg-0" role="search" method="get" action="@Url.Action("Index", "SachOnline")">
                <input class="form-control" type="search" placeholder="Tìm sách, tác giả..." name="data" value="@(Request["data"] ?? "")" aria-label="Tìm kiếm" />
                <button class="btn btn-search" type="submit"><i class="bi bi-search"></i></button>
            </form>
            <ul class="navbar-nav so-nav-cart align-items-lg-center">
                @Html.Action("LoginLogout", "SachOnline")
                @Html.Action("GioHangPartial", "GioHang")
            </ul>
        </div>
    </div>
</nav>
