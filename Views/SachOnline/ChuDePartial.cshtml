@model IEnumerable<TanHoangAnh.SachOnline.Models.CHUDE>
<aside class="so-sidebar-widget">
    <div class="widget-header"><i class="bi bi-bookmarks"></i> Sách theo chủ đề</div>
    <ul class="list-group list-group-flush">
        @foreach (var chude in Model)
        {
            <li class="list-group-item">
                <a href="@Url.Action("SachTheoChuDe", "SachOnline", new { id = chude.MaCD })">
                    @chude.TenChuDe <i class="bi bi-chevron-right"></i>
                </a>
            </li>
        }
    </ul>
</aside>
