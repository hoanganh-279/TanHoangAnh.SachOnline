@model IEnumerable<TanHoangAnh.SachOnline.Models.SACH>
@{ var rank = 0; }
<section class="so-section" id="bestseller">
    <header class="so-section-header">
        <div>
            <h2>Sách bán chạy</h2>
            <p class="subtitle">Top sách được khách hàng yêu thích nhất</p>
        </div>
    </header>
    <div class="row g-3 so-bestseller-grid">
        @foreach (var sach in Model)
        {
            rank++;
            <div class="col-md-6">
                <article class="so-bestseller-item">
                    <span class="so-bestseller-rank">@rank</span>
                    <a href="@Url.Action("ChiTietSach", "SachOnline", new { id = sach.MaSach })">
                        <img src="~/Images/@sach.AnhBia" alt="@sach.TenSach" />
                    </a>
                    <div class="so-bestseller-info">
                        <h6><a href="@Url.Action("ChiTietSach", "SachOnline", new { id = sach.MaSach })">@sach.TenSach</a></h6>
                        <p class="price">@String.Format("{0:#,##0}", sach.GiaBan) ₫</p>
                        <p class="sold">Đã bán: <strong>@sach.SoLuongBan</strong> cuốn</p>
                    </div>
                </article>
            </div>
        }
    </div>
</section>
