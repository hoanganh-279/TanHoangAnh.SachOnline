@using TanHoangAnh.SachOnline.Models
@{ KHACHHANG kh = (KHACHHANG)Session["TaiKhoan"]; }
@if (Session["TaiKhoan"] == null)
{
    <li class="nav-item"><a class="nav-link" href="@Url.Action("DangKy", "User")"><i class="bi bi-person-plus me-1"></i> Đăng ký</a></li>
    <li class="nav-item"><a class="nav-link" href="@Url.Action("DangNhap", "User", new { url = Request.Url.ToString() })"><i class="bi bi-box-arrow-in-right me-1"></i> Đăng nhập</a></li>
}
else
{
    <li class="nav-item"><a class="nav-link" href="#"><i class="bi bi-person-circle me-1"></i> Xin chào: @kh.HoTen</a></li>
    <li class="nav-item"><a class="nav-link" href="@Url.Action("DangXuat", "User")"><i class="bi bi-box-arrow-right me-1"></i> Đăng xuất</a></li>
}
