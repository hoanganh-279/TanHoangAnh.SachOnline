@using PagedList.Mvc;
@using TanHoangAnh.SachOnline.Models;
@model PagedList.IPagedList<SACH>

@{
    ViewBag.Title = "Trang chủ";
    Layout = "~/Views/Shared/_LayoutUser.cshtml";
}

@Styles.Render("~/Content/PagedList.css")

@section NhaXuatBanPartial {
    @Html.Action("NhaXuatBanPartial", "SachOnline")
}

@section SachBanNhieuPartial {
    @Html.Action("SachBanNhieuPartial", "SachOnline")
}

@section SliderPartial {
    @Html.Action("SliderPartial", "SachOnline")
}

@section NavPartial {
    @Html.Action("NavPartial", "SachOnline", new { activeMenu = "Index" })
}

@section FooterPartial {
    @Html.Action("FooterPartial", "SachOnline")
}

<section class="so-section">
    <header class="so-section-header">
        <div>
            <h2>Sách mới <span class="badge badge-new">Mới</span></h2>
            <p class="subtitle">Cập nhật liên tục — Ưu đãi hấp dẫn mỗi tuần</p>
        </div>
    </header>

    <div class="row g-4">
        @foreach (var sach in Model)
        {
            <div class="col-sm-6 col-xl-4">
                <article class="so-book-card">
                    <div class="card-cover">
                        @if (sach.NgayCapNhat.HasValue && sach.NgayCapNhat.Value > DateTime.Now.AddDays(-30))
                        {
                            <span class="card-badge">Mới</span>
                        }
                        <a href="@Url.Action("ChiTietSach", "SachOnline", new { id = sach.MaSach })">
                            <img src="~/Images/@sach.AnhBia" alt="@sach.TenSach" />
                        </a>
                    </div>
                    <div class="card-body">
                        <h3 class="card-title">
                            <a href="@Url.Action("ChiTietSach", "SachOnline", new { id = sach.MaSach })">@sach.TenSach</a>
                        </h3>
                        <p class="card-price">@String.Format("{0:#,##0}", sach.GiaBan) ₫</p>
                        @if (sach.SoLuongBan.HasValue)
                        {
                            <p class="card-sold"><i class="bi bi-fire text-danger"></i> Đã bán @sach.SoLuongBan cuốn</p>
                        }
                        <div class="card-actions">
                            <a href="@Url.Action("ChiTietSach", "SachOnline", new { id = sach.MaSach })" class="btn-detail">Xem chi tiết</a>
                            <a href="@Url.Action("ChiTietSach", "SachOnline", new { id = sach.MaSach })" class="btn-cart" title="Thêm vào giỏ">
                                <i class="bi bi-cart-plus"></i>
                            </a>
                        </div>
                    </div>
                </article>
            </div>
        }
    </div>

    <div class="so-pagination-wrap">
        <p class="text-muted mb-2">Trang @(Model.PageCount < Model.PageNumber ? 0 : Model.PageNumber) / @Model.PageCount</p>
        @Html.PagedListPager(Model, page => Url.Action("Index", new { page = page }),
            new PagedListRenderOptions { UlElementClasses = new[] { "pagination" } })
    </div>
</section>
