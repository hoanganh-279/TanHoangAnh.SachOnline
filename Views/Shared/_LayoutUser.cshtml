<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - SachOnline</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="~/Content/bootstrap.min.css" rel="stylesheet" />
    <link href="~/Content/sachonline-home.css" rel="stylesheet" />
</head>
<body class="so-page">
    @RenderSection("NavPartial", required: false)
    @RenderSection("SliderPartial", required: false)
    <div class="so-trust-strip d-none d-md-block">
        <div class="container">
            <div class="row g-3 text-center text-md-start">
                <div class="col-md-3 col-6">
                    <div class="so-trust-item justify-content-center justify-content-md-start">
                        <i class="bi bi-truck"></i>
                        <div><strong>Giao hàng toàn quốc</strong><span>Miễn phí đơn từ 300.000đ</span></div>
                    </div>
                </div>
                <div class="col-md-3 col-6">
                    <div class="so-trust-item justify-content-center justify-content-md-start">
                        <i class="bi bi-shield-check"></i>
                        <div><strong>Sách chính hãng</strong><span>100% nguồn gốc rõ ràng</span></div>
                    </div>
                </div>
                <div class="col-md-3 col-6">
                    <div class="so-trust-item justify-content-center justify-content-md-start">
                        <i class="bi bi-arrow-repeat"></i>
                        <div><strong>Đổi trả dễ dàng</strong><span>Trong vòng 7 ngày</span></div>
                    </div>
                </div>
                <div class="col-md-3 col-6">
                    <div class="so-trust-item justify-content-center justify-content-md-start">
                        <i class="bi bi-headset"></i>
                        <div><strong>Hỗ trợ 24/7</strong><span>Hotline: 1900 1234</span></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <main class="container so-main-wrap">
        <div class="row">
            <aside class="col-lg-3 col-md-4 mb-4 mb-md-0">
                @Html.Action("ChuDePartial", "SachOnline")
                @RenderSection("NhaXuatBanPartial", required: false)
            </aside>
            <div class="col-lg-9 col-md-8">
                @RenderBody()
                @RenderSection("SachBanNhieuPartial", required: false)
            </div>
        </div>
    </main>
    @RenderSection("FooterPartial", required: false)
    <script src="~/Scripts/jquery-3.7.0.min.js"></script>
    <script src="~/Scripts/bootstrap.bundle.js"></script>
    @RenderSection("scripts", required: false)
</body>
</html>
