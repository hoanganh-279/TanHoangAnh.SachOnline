<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewBag.Title - SachOnline Admin</title>

    <!-- Bootstrap 5.3 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    @* ✅ [SỬA LỖI 1] Thêm section styles để Dashboard đặt <link> CSS vào đúng vị trí trong <head>
        thay vì đặt lẫn trong body gây HTML không hợp lệ và FOUC *@
    @RenderSection("styles", required: false)

    <style>
        :root {
            --primary-color: #0d6efd;
            --primary-light: #e7f1ff;
            --primary-dark: #0a58ca;
            --sidebar-bg: #ffffff;
            --hover-bg: #f8f9ff;
            --text-primary: #2c3e50;
            --text-secondary: #6c757d;
            --border-color: #e9ecef;
            --shadow-sm: 0 2px 8px rgba(0,0,0,0.04);
            --shadow-md: 0 4px 16px rgba(0,0,0,0.08);
        }

        body {
            background-color: #f5f7fb;
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            color: var(--text-primary);
        }

        /* Sidebar Styling */
        .sidebar {
            position: fixed;
            top: 0;
            bottom: 0;
            left: 0;
            width: 280px;
            background: linear-gradient(180deg, #ffffff 0%, #fafbfc 100%);
            box-shadow: var(--shadow-md);
            z-index: 1000;
            overflow-y: auto;
            overflow-x: hidden;
            transition: all 0.3s ease;
        }

            .sidebar::-webkit-scrollbar {
                width: 6px;
            }

            .sidebar::-webkit-scrollbar-track {
                background: #f1f1f1;
            }

            .sidebar::-webkit-scrollbar-thumb {
                background: #c1c1c1;
                border-radius: 3px;
            }

        /* Brand Section */
        .sidebar-brand {
            padding: 24px 20px;
            border-bottom: 2px solid var(--border-color);
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        }

            .sidebar-brand a {
                text-decoration: none;
                display: flex;
                align-items: center;
                gap: 12px;
            }

            .sidebar-brand h4 {
                color: white;
                font-weight: 700;
                margin: 0;
                font-size: 1.4rem;
                letter-spacing: 0.5px;
            }

            .sidebar-brand small {
                color: rgba(255,255,255,0.9);
                font-size: 0.85rem;
                margin-top: 4px;
                display: block;
            }

        .brand-icon {
            width: 40px;
            height: 40px;
            background: rgba(255,255,255,0.2);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
        }

        /* Navigation */
        .nav-section {
            padding: 20px 12px;
        }

        .nav-section-title {
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: var(--text-secondary);
            font-weight: 600;
            padding: 8px 16px;
            margin-bottom: 8px;
        }

        .nav-link {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 14px 16px;
            margin: 4px 8px;
            border-radius: 12px;
            color: var(--text-secondary);
            font-weight: 500;
            font-size: 0.95rem;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            position: relative;
            overflow: hidden;
            text-decoration: none;
        }

            .nav-link i {
                font-size: 1.2rem;
                width: 24px;
                text-align: center;
                transition: all 0.3s ease;
            }

            .nav-link:hover {
                background-color: var(--hover-bg);
                color: var(--primary-color);
                transform: translateX(4px);
            }

                .nav-link:hover i {
                    transform: scale(1.1);
                }

            .nav-link.active {
                background: linear-gradient(135deg, var(--primary-light) 0%, #d4e4ff 100%);
                color: var(--primary-dark);
                font-weight: 600;
                box-shadow: 0 4px 12px rgba(13, 110, 253, 0.15);
                border-left: 4px solid var(--primary-color);
                padding-left: 12px;
                transition: background 0.3s ease, color 0.3s ease;
            }

                .nav-link.active i {
                    color: var(--primary-color);
                    transform: scale(1.1);
                }

        /* Logout Section */
        .sidebar-footer {
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            padding: 20px;
            border-top: 2px solid var(--border-color);
            background: #fafbfc;
        }

        .btn-logout {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            padding: 10px 16px;
            border: 2px solid #dc3545;
            background: transparent;
            color: #dc3545;
            font-weight: 500;
            border-radius: 8px;
            transition: all 0.3s ease;
            text-decoration: none;
            width: 100%;
        }

            .btn-logout:hover {
                background: #dc3545;
                color: white;
                transform: translateY(-2px);
                box-shadow: 0 4px 12px rgba(220, 53, 69, 0.2);
            }

        .main-content {
            margin-left: 280px;
            min-height: 100vh;
            padding: 80px 24px 24px 24px;
            transition: all 0.3s ease;
        }

        /* Top Navbar */
        .top-navbar {
            margin-left: 280px;
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            box-shadow: var(--shadow-sm);
            transition: all 0.3s ease;
            height: 56px;
        }

        .navbar-brand {
            font-weight: 700;
            color: var(--primary-color) !important;
        }

        .dropdown-menu {
            border: none;
            box-shadow: var(--shadow-md);
            border-radius: 12px;
            padding: 8px;
        }

        .dropdown-item {
            border-radius: 8px;
            padding: 10px 16px;
            transition: all 0.2s ease;
        }

            .dropdown-item:hover {
                background-color: var(--primary-light);
                color: var(--primary-color);
            }

        /* Responsive */
        @@media (max-width: 992px) {
            .sidebar {
                transform: translateX(-100%);
            }

                .sidebar.show {
                    transform: translateX(0);
                }

            .main-content,
            .top-navbar {
                margin-left: 0;
            }

            .main-content {
                padding: 70px 16px 16px 16px;
            }
        }

        @@keyframes slideIn {
            from {
                opacity: 0;
                transform: translateX(-20px);
            }

            to {
                opacity: 1;
                transform: translateX(0);
            }
        }

        .nav-link {
            animation: slideIn 0.3s ease forwards;
        }

            .nav-link:nth-child(2) {
                animation-delay: 0.05s;
            }

            .nav-link:nth-child(3) {
                animation-delay: 0.1s;
            }

            .nav-link:nth-child(4) {
                animation-delay: 0.15s;
            }

            .nav-link:nth-child(5) {
                animation-delay: 0.2s;
            }

            .nav-link:nth-child(6) {
                animation-delay: 0.25s;
            }

            .nav-link:nth-child(7) {
                animation-delay: 0.3s;
            }
    </style>
</head>
<body>

    <!-- Sidebar -->
    <div class="sidebar" id="sidebar">
        <div class="sidebar-brand">
            <a href="@Url.Action("Dashboard", "Home")">
                <div class="brand-icon">
                    <i class="bi bi-book"></i>
                </div>
                <div>
                    <h4>SachOnline</h4>
                    <small>Quản trị viên</small>
                </div>
            </a>
        </div>

        <div class="nav-section">
            <div class="nav-section-title">Menu Chính</div>

            <a class="nav-link @(ViewBag.ActiveMenu == "Dashboard" ? "active" : "")"
               href="@Url.Action("Dashboard","Home")">
                <i class="bi bi-house-door-fill"></i>
                <span>Trang chủ</span>
            </a>

            <a class="nav-link @(ViewBag.ActiveMenu == "Sach" ? "active" : "")"
               href="@Url.Action("Index","Sach")">
                <i class="bi bi-book-half"></i>
                <span>Quản lý Sách</span>
            </a>

            <a class="nav-link @(ViewBag.ActiveMenu == "ChuDe" ? "active" : "")"
               href="@Url.Action("Index","ChuDe")">
                <i class="bi bi-tags-fill"></i>
                <span>Quản lý Chủ đề</span>
            </a>

            <a class="nav-link @(ViewBag.ActiveMenu == "NhaXuatBan" ? "active" : "")"
               href="@Url.Action("Index","NhaXuatBan")">
                <i class="bi bi-building-fill"></i>
                <span>Quản lý NXB</span>
            </a>
        </div>

        <div class="nav-section">
            <div class="nav-section-title">Quản lý</div>

            <a class="nav-link @(ViewBag.ActiveMenu == "KhachHang" ? "active" : "")"
               href="@Url.Action("Index","KhachHang")">
                <i class="bi bi-people-fill"></i>
                <span>Khách hàng</span>
            </a>

            <a class="nav-link @(ViewBag.ActiveMenu == "DonHang" ? "active" : "")"
               href="@Url.Action("Index","DonHang")">
                <i class="bi bi-receipt-cutoff"></i>
                <span>Đơn hàng</span>
            </a>
        </div>

        <div class="sidebar-footer">
            <a href="@Url.Action("Logout","Home")" class="btn-logout">
                <i class="bi bi-box-arrow-right"></i>
                <span>Đăng xuất</span>
            </a>
        </div>
    </div>

    <!-- Top Navbar -->
    <nav class="navbar navbar-expand-lg navbar-light top-navbar fixed-top">
        <div class="container-fluid">
            <button class="btn btn-link d-lg-none" type="button" id="sidebarToggle">
                <i class="bi bi-list fs-4"></i>
            </button>

            <div class="collapse navbar-collapse" id="navbarContent">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle d-flex align-items-center gap-2"
                           href="#" role="button" data-bs-toggle="dropdown">
                            <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center"
                                 style="width: 36px; height: 36px;">
                                <i class="bi bi-person"></i>
                            </div>
                            <span class="fw-semibold">Admin</span>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item" href="#"><i class="bi bi-person me-2"></i>Hồ sơ</a></li>
                            <li><a class="dropdown-item" href="#"><i class="bi bi-gear me-2"></i>Cài đặt</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                @* ✅ [SỬA LỖI 2] Đổi controller "Account" → "Home" cho đúng.
                                    Trước đây trỏ sai sang controller "Account" không tồn tại → lỗi 404 *@
                                <a class="dropdown-item text-danger" href="@Url.Action("Logout","Home")">
                                    <i class="bi bi-box-arrow-right me-2"></i>Đăng xuất
                                </a>
                            </li>
                        </ul>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <div class="main-content">
        <div class="container-fluid">
            @RenderBody()
        </div>
    </div>

    <!-- Scripts -->
    @* ✅ [SỬA LỖI 3] jQuery phải load TRƯỚC Bootstrap để tránh conflict tiềm ẩn *@
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        // @@ts-nocheck
        // Sidebar toggle for mobile
        document.getElementById('sidebarToggle')?.addEventListener('click', function () {
            document.getElementById('sidebar').classList.toggle('show');
        });

        // Close sidebar when clicking outside on mobile
        document.addEventListener('click', function (e) {
            const sidebar = document.getElementById('sidebar');
            const toggle = document.getElementById('sidebarToggle');

            if (window.innerWidth < 992 &&
                !sidebar.contains(e.target) &&
                !toggle.contains(e.target)) {
                sidebar.classList.remove('show');
            }
        });

        $(document).ready(function () {
            $('.nav-link').on('click', function (e) {
                if (!$(this).hasClass('active')) {
                    $('.nav-link').removeClass('active');
                    $(this).addClass('active');
                }
            });
        });
    </script>

    @RenderSection("scripts", required: false)
</body>
</html>
